# ==========================================
# Weatheroo App - Environment Variables Template
# ==========================================
# INSTRUCTIONS:
# 1. Copy this file and rename the copy to strictly `.env`
# 2. Replace the placeholder values with your actual local secrets.
# ==========================================

# WeatherAPI Configuration
# You can generate a free API key at: https://www.weatherapi.com/
WEATHER_API_KEY=insert_your_weatherapi_key_here

# PostgreSQL Database Configuration
# Used by docker-compose.yml to spin up the local database
DB_USERNAME=weatheroo_user
DB_PASSWORD=weatheroo_secret
DB_NAME=weatheroo_db
DB_PORT=5432